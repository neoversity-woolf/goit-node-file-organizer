{
  "name": "file-organizer",
  "version": "1.0.0",
  "description": "CLI tool to scan directories, find duplicates, organize files by category, and clean up old files",
  "type": "module",
  "main": "file-organizer.js",
  "bin": {
    "file-organizer": "./file-organizer.js"
  },
  "scripts": {
    "scan": "node file-organizer.js scan",
    "duplicates": "node file-organizer.js duplicates",
    "organize": "node file-organizer.js organize",
    "cleanup": "node file-organizer.js cleanup"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "keywords": [
    "cli",
    "file-organizer",
    "nodejs",
    "streams",
    "events",
    "sha256"
  ],
  "author": "Yaroslav Kosytsia <yaroslavkosytsia@gmail.com>",
  "license": "MIT"
}
